# Edge Device Environment Configuration
# Copy this file to .env and update the values

# Gate Configuration
SNITCH_GATE_ID=gate_001
SNITCH_STATION_ID=station_001

# Camera URLs (RTSP streams)
SNITCH_CAMERA_URLS=["rtsp://admin:password@192.168.1.100:554/stream1","rtsp://admin:password@192.168.1.101:554/stream1"]

# Detection Settings
SNITCH_DETECTION_CONFIDENCE=0.5
SNITCH_DETECTION_IOU_THRESHOLD=0.45

# Server Configuration
SNITCH_SERVER_URL=http://192.168.1.50:8000
SNITCH_SERVER_API_KEY=your-api-key-here

# Processing Settings
SNITCH_FRAME_SKIP=5
SNITCH_DETECTION_INTERVAL=0.1

# Logging
SNITCH_LOG_LEVEL=INFO
SNITCH_LOG_FILE=logs/edge_device.log
