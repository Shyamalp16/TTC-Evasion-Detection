# Server Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
SNITCH_DATABASE_URL=postgresql://snitch:password@localhost:5432/snitchsystem
SNITCH_DATABASE_HOST=localhost
SNITCH_DATABASE_PORT=5432
SNITCH_DATABASE_NAME=snitchsystem
SNITCH_DATABASE_USER=snitch
SNITCH_DATABASE_PASSWORD=password

# API Configuration
SNITCH_API_HOST=0.0.0.0
SNITCH_API_PORT=8000

# Authentication
SNITCH_API_KEY=your-api-key-here
SNITCH_SECRET_KEY=your-secret-key-here

# File Storage
SNITCH_SNAPSHOTS_DIR=snapshots
SNITCH_MAX_FILE_SIZE_MB=10

# Logging
SNITCH_LOG_LEVEL=INFO
SNITCH_LOG_FILE=logs/server.log

# Data Retention
SNITCH_EVENT_RETENTION_DAYS=90
SNITCH_SNAPSHOT_RETENTION_DAYS=30
